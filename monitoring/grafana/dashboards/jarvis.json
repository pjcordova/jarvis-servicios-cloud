    {
      "id": 7,
      "type": "timeseries",
      "title": "Herramientas por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (herramienta) (rate(jarvis_herramientas_total[1m])) * 60",
          "legendFormat": "{{herramienta}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Conversaciones, mensajes y llamadas a Gemini por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (origen) (rate(jarvis_sesiones_voz_total[1m])) * 60",
          "legendFormat": "voz {{origen}}"
        },
        {
          "refId": "B",
          "expr": "sum by (tipo) (rate(jarvis_telegram_mensajes_total[1m])) * 60",
          "legendFormat": "telegram {{tipo}}"
        },
        {
          "refId": "C",
          "expr": "sum by (modelo) (rate(jarvis_modelo_solicitudes_total[1m])) * 60",
          "legendFormat": "gemini {{modelo}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
