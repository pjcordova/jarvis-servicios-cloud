    {
      "id": 9,
      "type": "timeseries",
      "title": "Tasa de error",
      "description": "La línea roja es el objetivo (5 %).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jarvis_modelo_solicitudes_total{resultado!=\"ok\"}[1m])) / sum(rate(jarvis_modelo_solicitudes_total[1m]))",
          "legendFormat": "Gemini"
        },
        {
          "refId": "B",
          "expr": "sum(rate(jarvis_herramientas_total{resultado=\"fallo\"}[1m])) / sum(rate(jarvis_herramientas_total[1m]))",
          "legendFormat": "herramientas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
