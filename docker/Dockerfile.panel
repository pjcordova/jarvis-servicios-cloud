# El panel de Jarvis como servicio en un contenedor: la RÉPLICA en Google Cloud Run (scripts/desplegar-cloudrun.ps1).
# Es la misma app y la misma base (Neon, producción) que Vercel; Vercel sigue siendo la dirección principal.
# Las direcciones de Neon (Auth y Data API) entran al construir (Next las fija en el código del navegador); son
# públicas, no son claves. Ningún secreto va en la imagen (.dockerignore deja fuera los .env), así que en la réplica
# no hay avisos, cobros por correo ni reclamos, y no aparece Administración.
#   docker build -t jarvis-panel --build-arg NEXT_PUBLIC_NEON_AUTH_URL=… --build-arg NEXT_PUBLIC_NEON_DATA_API_URL=… panel
FROM node:24.11.1-bookworm-slim AS construir
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG NEXT_PUBLIC_NEON_AUTH_URL
ARG NEXT_PUBLIC_NEON_DATA_API_URL
ARG NEXT_PUBLIC_JARVIS_REPLICA=si
# Dónde corre esta réplica (lo dice la banda de arriba): "Google Cloud Run" o "Kubernetes (k3s)".
ARG NEXT_PUBLIC_JARVIS_DONDE="Google Cloud Run"
ENV NEXT_PUBLIC_NEON_AUTH_URL=$NEXT_PUBLIC_NEON_AUTH_URL \
    NEXT_PUBLIC_NEON_DATA_API_URL=$NEXT_PUBLIC_NEON_DATA_API_URL \
    NEXT_PUBLIC_JARVIS_REPLICA=$NEXT_PUBLIC_JARVIS_REPLICA \
    NEXT_PUBLIC_JARVIS_DONDE=$NEXT_PUBLIC_JARVIS_DONDE \
    SALIDA_DOCKER=si \
    NEXT_TELEMETRY_DISABLED=1
RUN test -n "$NEXT_PUBLIC_NEON_AUTH_URL" && test -n "$NEXT_PUBLIC_NEON_DATA_API_URL" && npm run build

# Solo lo que hace falta para correr (output standalone): imagen chica y sin herramientas de construcción.
FROM node:24.11.1-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 TZ=America/Lima
COPY --from=construir --chown=node:node /app/.next/standalone ./
COPY --from=construir --chown=node:node /app/.next/static ./.next/static
COPY --from=construir --chown=node:node /app/public ./public
USER node
EXPOSE 8080
CMD ["node", "server.js"]
