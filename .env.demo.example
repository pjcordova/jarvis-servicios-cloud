# Jarvis en Docker (demo de la clase). Copia este archivo como .env.demo y completa.
# .env.demo no entra en Git ni en la imagen: Docker lo lee al arrancar el contenedor.

# Recomendado: una API key aparte para la demo (Google AI Studio), que puedas revocar después de la clase.
GEMINI_API_KEY=

# Opcional (pasos siguientes): bot de Telegram solo para la demo, creado con @BotFather.
# No uses el token de tu Jarvis de siempre: dos copias con el mismo bot chocan.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PERMITIDOS=

# Con bot de demo, las alertas del monitoreo también llegan por Telegram.

# En la demo, sin aviso diario ni cierre del día programados.
AVISO_HORA=no
CIERRE_HORA=no

# Opcionales
# GEMINI_MODELO=gemini-3.8-live
# GEMINI_MODELO_TEXTO=gemini-3.8-flash
# JARVIS_VOZ=Charon
